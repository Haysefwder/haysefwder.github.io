# Connection string for the PostgreSQL database used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rpgzando?schema=public"

# Secret used to sign session JWTs (auth). Generate a strong random value for production,
# e.g. `openssl rand -base64 32`.
AUTH_SECRET="dev-only-secret-change-me-please-0123456789"

# AI Game Master configuration.
#
# AI_PROVIDER selects which LLM narrates the campaigns: "gemini", "openai" or
# "anthropic". Only the matching API key below needs to be set. If AI_PROVIDER is
# empty/unset, or the matching key is missing, the app falls back to a
# deterministic mock Game Master (no external calls, no cost).
AI_PROVIDER=

# Required when AI_PROVIDER=openai. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Required when AI_PROVIDER=gemini. Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Required when AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the default model used by each provider.
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-4-5
